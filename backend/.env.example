# ==============================================================================
# Campus Ballot — Environment & Database Configuration
# ==============================================================================
# 100% Free of Cost — No paid services or subscriptions required.
# ==============================================================================

# --- DATABASE CONFIGURATION ---
# Option 1: Render PostgreSQL (Recommended for cloud deployment)
# Render provides this in Dashboard -> PostgreSQL -> Internal Database URL
# DATABASE_URL=postgresql://user:password@dpg-xxxxxx-a:5432/campus_ballot

# Option 2: Local / Persistent SQLite (Default when DATABASE_URL is not set)
DATABASE_PATH=campus_ballot.db
# On Render with Persistent Disk: DATABASE_PATH=/data/campus_ballot.db

# --- SECURITY & SESSIONS ---
# Set to true when running over HTTPS (production). Keep false for local localhost testing.
COOKIE_SECURE=false

# Secret key used for signing JWT authentication session tokens
SECRET_KEY=campus-ballot-super-secret-key-change-this-for-production-use-2026

# Session duration in hours before student/admin must re-authenticate
SESSION_HOURS=8

# PBKDF2 hashing work factor (600,000 is OWASP 2024+ recommendation)
PBKDF2_ITERATIONS=600000

# --- DEFAULT ADMINISTRATOR BOOTSTRAP ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@Campus2026!

# --- TIMEZONE ---
# Campus election timezone for start/end scheduling (e.g. Asia/Kolkata, UTC, America/New_York)
APP_TIMEZONE=Asia/Kolkata

# --- SERVER RUNTIME ---
PORT=8000
