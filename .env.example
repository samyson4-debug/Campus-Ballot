# ==============================================================================
# Campus Ballot — Environment Configuration Template
# Copy this file to .env and customize for your deployment environment
# ==============================================================================

# Cryptographic secret for signing JWT session tokens (generate a strong 64+ char random string)
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production-use-openssl-rand-hex-32

# Default bootstrap Administrator credentials
ADMIN_USERNAME=admin
# If left blank, a secure random password will be auto-generated and printed to logs once on first boot
ADMIN_PASSWORD=Admin@Campus2026!

# Database storage path (on Docker/Render, use /data/campus_ballot.db; locally use ./campus_ballot.db)
DATABASE_PATH=./campus_ballot.db

# Campus Timezone (IANA format, e.g. Asia/Kolkata, America/New_York, UTC)
APP_TIMEZONE=Asia/Kolkata

# Cookie security: set to true in production (requires HTTPS), false for local plain HTTP development
COOKIE_SECURE=false

# Session cookie lifetime in hours (default: 8)
SESSION_HOURS=8

# Password hashing iterations (PBKDF2-HMAC-SHA256, recommended: 600000)
PBKDF2_ITERATIONS=600000
